# Copy to .env (never commit it). Loaded with `node --env-file=.env`.

PORT=3000
HOST=127.0.0.1
TRUST_PROXY=true              # behind nginx
COOKIE_SECURE=true            # set false only for plain-http local testing
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
SERVE_DIST=                   # optional: path to the built UI (dist/) if the backend should serve it

# MongoDB: users, sessions, login rate-limit, audit log, Kuma history
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=homelab

# Proxmox (API token, roles: VM.PowerMgmt, VM.Audit, Sys.Audit)
PVE_URL=https://192.168.1.10:8006
PVE_NODE=pve
PVE_TOKEN_ID=dashboard@pve!ui
PVE_TOKEN_SECRET=
PVE_INSECURE_TLS=true         # self-signed cert
ALLOWED_VMIDS=                # comma list; empty = all guests on the node
PROTECTED_VMIDS=120           # refused server-side for every action
GUEST_CONFLICTS={"100":[101,106],"101":[100],"106":[100]}
# Kill switch: lets the dashboard power off the whole Proxmox node (needs Sys.PowerMgmt on /nodes/<node>).
# Powering back on is not possible from here (the dashboard dies with the host).
HOST_POWER_ENABLED=false

# nginx (read-only bind mount)
NGINX_SITES_DIR=/etc/nginx/sites-enabled

# Grafana (read-only service account token; allow_embedding = true)
GRAFANA_URL=http://192.168.1.14:3000
GRAFANA_PUBLIC_URL=https://grafana.home.lan
GRAFANA_TOKEN=
PROMETHEUS_URL=              # optional, e.g. http://192.168.1.21:9090 (queried directly, bypassing Grafana)
GRAFANA_DS_UID=               # Prometheus datasource uid

# Uptime Kuma (/metrics with API key)
KUMA_URL=http://192.168.1.15:3001
KUMA_API_KEY=
KUMA_POLL_MS=60000

# Extra origins the UI may embed in iframes (space separated), e.g. the Kuma status page host
FRAME_SRC=

# Loki (read-only; the Logs page queries it live, nothing is copied into MongoDB)
LOKI_URL=http://10.10.10.121:3100
LOKI_PUBLIC_URL=https://loki.splsystems.in

# Host journal for the Logs page (the service user must be in the systemd-journal group)
JOURNAL_ENABLED=true
EVENT_RETENTION_DAYS=90

# Keycloak sign-in (optional). Create a confidential OIDC client with the redirect URI below.
# SSO stays OFF unless KEYCLOAK_ALLOWED_USERS and/or KEYCLOAK_REQUIRED_ROLE is set.
KEYCLOAK_ISSUER=              # https://sso.example.com/realms/<realm>
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=        # https://<dashboard host>/api/auth/sso/callback
KEYCLOAK_ALLOWED_USERS=       # comma list of preferred_username or email
KEYCLOAK_REQUIRED_ROLE=       # realm role or client role
KEYCLOAK_LABEL=Keycloak

# ntfy push alerts (optional). Topic should be unguessable if the server allows anonymous subscribe.
NTFY_URL=
NTFY_PUBLIC_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_CLICK_URL=
# alert thresholds (fractions), sustained 5 min
ALERT_CPU=0.9
ALERT_MEM=0.92
ALERT_DISK=0.9

# Ask AI: optional OpenAI-compatible endpoint for inline log debugging.
# A local Ollama keeps data on your LAN: AI_BASE_URL=http://10.10.10.x:11434/v1, AI_MODEL=llama3.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_LABEL=
