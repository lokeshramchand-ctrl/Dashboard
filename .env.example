# Copy to .env (never commit it). Used by docker compose and `node --env-file`.

PORT=3000
HOST=127.0.0.1
TRUST_PROXY=true              # behind nginx
COOKIE_SECURE=false           # plain http on a LAN; set true behind an HTTPS reverse proxy
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
SERVE_DIST=                   # optional: path to the built UI (dist/) if the backend should serve it

# MongoDB: users, sessions, login rate-limit, audit log, Kuma history
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=homelab

# Proxmox (API token, roles: VM.PowerMgmt, VM.Audit, Sys.Audit)
PVE_URL=https://192.168.1.10:8006
PVE_NODE=pve
PVE_TOKEN_ID=dashboard@pve!ui
PVE_TOKEN_SECRET=
PVE_INSECURE_TLS=true         # self-signed cert
ALLOWED_VMIDS=                # comma list; empty = all guests on the node
PROTECTED_VMIDS=120           # refused server-side for every action
GUEST_CONFLICTS={"100":[101,106],"101":[100],"106":[100]}

# nginx (read-only bind mount)
NGINX_SITES_DIR=/etc/nginx/sites-enabled

# Grafana (read-only service account token; allow_embedding = true)
GRAFANA_URL=http://192.168.1.14:3000
GRAFANA_PUBLIC_URL=https://grafana.home.lan
GRAFANA_TOKEN=
PROMETHEUS_URL=              # optional, e.g. http://192.168.1.21:9090 (queried directly, bypassing Grafana)
GRAFANA_DS_UID=               # Prometheus datasource uid

# Uptime Kuma (/metrics with API key)
KUMA_URL=http://192.168.1.15:3001
KUMA_API_KEY=
KUMA_POLL_MS=60000

# ---- docker compose only ----
APP_PORT=3000                 # host port published by compose
NGINX_SITES_HOST_DIR=./nginx-sites   # host dir mounted read-only at /etc/nginx/sites-enabled
